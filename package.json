{
  "name": "smis-lunch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "watch": "node scripts/watch.mjs",
    "check": "node scripts/check-months.mjs",
    "validate": "node -e \"for(const f of require('fs').readdirSync('data')) require('child_process').execFileSync(process.execPath,['scripts/validate-month.mjs','data/'+f],{stdio:'inherit'})\""
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "esbuild": "^0.25.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
